# ============================================================
#  CONFIGURACIÓN DE PAGOS – Koon Artesanos
#  Copia este archivo como .env (local) o carga estas variables en
#  Vercel → Settings → Environment Variables.
# ============================================================

# URL pública del sitio (sin diagonal final). Se usa para las URLs de retorno del pago.
SITE_URL=https://koonartesanos.com

# Pasarelas activas, separadas por coma. Opciones: stripe, mercadopago, transferencia
# El cliente elige entre las que estén aquí. Ejemplo: PAYMENT_PROVIDERS=mercadopago,stripe,transferencia
PAYMENT_PROVIDERS=mercadopago,transferencia

# ---------- Mercado Pago (Checkout Pro) ----------
# Panel: https://www.mercadopago.com.mx/developers/panel/app → Credenciales de producción
MP_ACCESS_TOKEN=PEGA_AQUI_TU_ACCESS_TOKEN_DE_MERCADO_PAGO
# Firma secreta del webhook (Notificaciones → Webhooks → Clave secreta). Opcional pero recomendado.
MP_WEBHOOK_SECRET=

# ---------- Stripe (Checkout) ----------
# Panel: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=PEGA_AQUI_TU_SECRET_KEY_DE_STRIPE
# Panel: Developers → Webhooks → endpoint https://TU-DOMINIO/api/webhook-stripe → Signing secret
STRIPE_WEBHOOK_SECRET=PEGA_AQUI_EL_SIGNING_SECRET

# ---------- Transferencia bancaria (pago manual) ----------
# Se muestra al cliente al terminar el pedido. Déjalo vacío para no ofrecer esta opción.
BANK_TRANSFER_INFO="Banco: BBVA · Beneficiario: Koon Blanc, S.A. de C.V. · CLABE: 000000000000000000 · Envía tu comprobante por WhatsApp o a contacto@koonartesanos.com"

# ---------- Notificaciones de pedidos por correo (opcional, vía Resend) ----------
# https://resend.com → API Keys. Si está vacío, los pedidos solo quedan en los registros (logs) de Vercel.
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=contacto@koonartesanos.com
ORDER_FROM_EMAIL=pedidos@koonartesanos.com
